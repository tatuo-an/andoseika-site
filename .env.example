# MicroCMS Settings
# 管理画面: https://microcms.io/dashboard
# サービスドメイン (例: giant-spirit)
MICROCMS_SERVICE_DOMAIN=
# APIキー (読み取り専用でOK)
MICROCMS_API_KEY=

# Stripe Settings
# テスト環境/本番環境のキーを設定してください
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# 受取完了後アンケートのGoogleフォームURL（作成後に設定）
NEXT_PUBLIC_SURVEY_FORM_URL=
# アンケートフォーム送信後の確認メッセージに表示する合言葉（フォームの「設定」→「プレゼンテーション」→
# 「確認メッセージ」に同じ文言を設定してください。サーバー専用の値なのでNEXT_PUBLIC_は付けないこと）
SURVEY_PASSWORD=

# LINE注文管理（管理画面 /admin/line-orders）
# 「LINE注文管理」スプレッドシートのID
LINE_ORDER_SPREADSHEET_ID=
# お客様へのLINE通知に使うMessaging APIチャネルアクセストークン。
# LINE注文のLIFFアプリと同じLINE公式アカウントのトークンを設定してください。
# 未設定の場合はサイト本体の LINE_CHANNEL_ACCESS_TOKEN にフォールバックします
# （実際には別チャネルの場合、通知が届かないので要確認）
LINE_ORDER_CHANNEL_ACCESS_TOKEN=
