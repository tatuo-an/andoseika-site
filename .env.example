# MicroCMS Settings
# 管理画面: https://microcms.io/dashboard
# サービスドメイン (例: giant-spirit)
MICROCMS_SERVICE_DOMAIN=
# APIキー (読み取り専用でOK)
MICROCMS_API_KEY=

# Stripe Settings
# テスト環境/本番環境のキーを設定してください
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# 受取完了後アンケートのGoogleフォームURL（作成後に設定）
NEXT_PUBLIC_SURVEY_FORM_URL=
# フォームの「メールアドレス」質問の事前入力ID（フォームの「⋮」→「事前入力したリンクを取得」で
# メールアドレス欄だけ適当な値を入れて生成し、URL中の entry.XXXXXXXXX の数字部分だけを設定）
NEXT_PUBLIC_SURVEY_FORM_EMAIL_ENTRY_ID=
